+  const promise = fn()
+    .then((value) => {
+      cache.set(key, { value, expires: Date.now() + ttlMs });
+      return value;
+    })
+    .finally(() => {
+      cacheInFlight.delete(key);
+    });
+
+  cacheInFlight.set(key, promise);
+  return promise;
