+  const direction: "LONG" | "SHORT" | "NEUTRAL" = frame.state.includes("LONG")
+    ? "LONG"
+    : frame.state.includes("SHORT")
+    ? "SHORT"
+    : "NEUTRAL";
+  return { frame, isConfirmed, direction };
+}
