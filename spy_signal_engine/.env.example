SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Shared secret gating /ws (query param ?token=) and /history (X-Spy-Engine-Secret
# header). Generate with `openssl rand -hex 32`; must match the frontend's
# server-only SPY_ENGINE_SECRET env var exactly.
SPY_ENGINE_SECRET=
SYMBOL=SPY
VOLUME_RATIO_THRESHOLD=1.10
SR_PROXIMITY_PCT=0.0015
LOOKBACK_5M_BARS=80
LOOKBACK_1M_BARS=30
PORT=8787
